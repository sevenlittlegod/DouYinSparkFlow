[Unit]
Description=Douyin SparkFlow configuration portal
After=network.target

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/opt/douyinsparkflow
Environment=PORTAL_PUBLIC_ORIGIN=https://YOUR_DOMAIN
Environment=PORTAL_BASE_PATH=/spark
ExecStart=/opt/douyinsparkflow/.portal-venv/bin/python -m portal.server --data-dir /opt/douyinsparkflow/portal-data --host 127.0.0.1 --port 18766
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/douyinsparkflow/portal-data
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
